        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="10px"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10px"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="10px"/>
        </Grid.ColumnDefinitions>
        <RadioButton Grid.RowSpan="2" Margin="0,258,0,0" Grid.Row="1" Grid.Column="1" Background="White" Click="Button_Click"/>
        <Image Source="/2.jpg" Grid.Column="1" Margin="58,258,58,0" Grid.RowSpan="2"/>
        <Label Content="Nagy Attila Ferenc" Grid.Column="1" Grid.Row="2" Height="100px" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="Premontrei Szakgimnázium &#xA;Technikum" Height="100px" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
    </Grid>


</Window>
